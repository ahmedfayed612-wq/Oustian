# ---------------------------------------------------------------------------
# Oustians — environment variables
# ---------------------------------------------------------------------------
# Local development: copy this file to `.env.local` (git-ignored) and fill it in.
# Vercel: add the same names under Project → Settings → Environment Variables.
# The build succeeds with none of them set; auth, database and storage need the
# three public ones below.
#
# ---------- Public: safe in the browser bundle (NEXT_PUBLIC_ prefix) ----------

# Absolute site URL. Used for metadata and for every auth redirect and email
# link, so Supabase's "Site URL" must match it.
#   local: http://localhost:3000
#   prod:  https://oustians.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard → Project Settings → API).
# The publishable key (sb_publishable_…) is safe in the browser: Row Level
# Security does the real work. The legacy anon key name
# (NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ…) is still accepted as a fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server-only: never NEXT_PUBLIC_, never imported by client code ----

# Bypasses Row Level Security. Not used in the request path today; reserved for
# local scripts (seeding, admin jobs) and support tooling.
SUPABASE_SERVICE_ROLE_KEY=

# Optional salt used to hash rate-limit keys (IP / email) before they land in
# the `rate_limits` table. Recommended in production; rotating it only resets
# the counters. Any random string works.
RATE_LIMIT_SALT=
