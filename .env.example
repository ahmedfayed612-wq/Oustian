# ---------------------------------------------------------------------------
# Oustians — environment variables
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Public site URL. Used for metadata, absolute links and (later) auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard -> Project Settings -> API).
# The anon key is safe in the browser: Row Level Security does the real work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_, never import it
# into client code. Used by local scripts (seeding, admin jobs) in M8.
SUPABASE_SERVICE_ROLE_KEY=
